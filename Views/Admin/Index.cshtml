@model IEnumerable<OrderDto>
@{
    ViewData["Title"] = "Admin Orders";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background-color: #fdf9f7;
        font-family: 'Segoe UI', sans-serif;
    }

    .topbar {
        background-color: #ffffff;
        border-bottom: 1px solid #f0e6e0;
    }

    .brand {
        font-family: 'Playfair Display', serif;
        letter-spacing: 1px;
    }

    .sidebar {
        background-color: #ffffff;
        border-right: 1px solid #f0e6e0;
        min-height: 100vh;
    }

        .sidebar a {
            color: #7a5c52;
            font-weight: 500;
            padding: 10px 15px;
            border-radius: 8px;
        }

            .sidebar a.active,
            .sidebar a:hover {
                background-color: #f5e7df;
                color: #5a3e36;
            }
</style>

<div class="topbar py-3 px-4 d-flex justify-content-between align-items-center">
    <h5 class="brand mb-0">Olore Jewelry Store</h5>
    <div>
        <a class="me-3 text-decoration-none text-muted" asp-controller="Home" asp-action="Index">Dashboard</a>
        <a class="text-decoration-none text-muted" href="/Account/Logout">Logout</a>
    </div>
</div>

<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        <div class="col-md-2 sidebar p-3">
            <nav class="nav flex-column gap-2">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="nav-link" href="/Admin/Products">Products</a>
                <a class="nav-link active" asp-controller="Admin" asp-action="Index">Orders</a>
                <a class="nav-link" href="/Admin/Users">Users</a>
            </nav>
        </div>

        <!-- Content -->
        <div class="col-md-10 p-5">
            <h3 class="mb-4" style="color:#5a3e36;">Orders</h3>

            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer Name</th>
                        <th>Status</th>
                        <th>Products</th>
                        <th>Total Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model != null && Model.Any())
                    {
                        @foreach(var order in Model)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.CustomerName</td>
                                <td>
                                    @if(order.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if(order.Status == "Shipped")
                                    {
                                        <span class="badge bg-success">Shipped</span>
                                    }
                                    else if(order.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@order.Status</span>
                                    }
                                </td>
                                <td>
                                    @if(order.OrderItems != null && order.OrderItems.Any())
                                    {
                                        @foreach(var item in order.OrderItems)
                                        {
                                            <div>@item.ProductName x @item.Quantity</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nuk ka produkte</span>
                                    }
                                </td>
                                <td>€@order.TotalPrice.ToString("0.00")</td>
                                <td>
                                    @if(order.Status == "Pending")
                                    {
                                        <form asp-action="Ship" asp-route-id="@order.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-success me-1">Start</button>
                                        </form>
                                        <form asp-action="Cancel" asp-route-id="@order.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No actions</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Nuk ka porosi për momentin
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

    </div>
</div>
