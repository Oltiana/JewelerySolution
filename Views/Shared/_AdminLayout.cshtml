<!DOCTYPE html>
<html>
<head>
    <title>Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #fdf9f7;
            font-family: 'Segoe UI', sans-serif;
        }

        .topbar {
            background-color: #ffffff;
            border-bottom: 1px solid #f0e6e0;
        }

        .brand {
            font-family: 'Playfair Display', serif;
            letter-spacing: 1px;
        }

        .sidebar {
            background-color: #ffffff;
            border-right: 1px solid #f0e6e0;
            min-height: 100vh;
        }

            .sidebar a {
                color: #7a5c52;
                font-weight: 500;
                padding: 10px 15px;
                border-radius: 8px;
            }

                .sidebar a:hover {
                    background-color: #f5e7df;
                    color: #5a3e36;
                }
    </style>
</head>

<body>

    <div class="topbar py-3 px-4 d-flex justify-content-between align-items-center">
        <h5 class="brand mb-0">Olore Jewelry Store</h5>
        <div>
            <a class="me-3 text-decoration-none text-muted" asp-controller="Home" asp-action="Index">Dashboard</a>
            <a class="text-decoration-none text-muted" asp-controller="Account" asp-action="Logout">Logout</a>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row">

            <!-- SIDEBAR -->
            <div class="col-md-2 sidebar p-3">
                <nav class="nav flex-column gap-2">
                    <a class="nav-link" asp-controller="Admin" asp-action="Index">Orders</a>
                    <a class="nav-link" asp-controller="AdminProduct" asp-action="Index">Products</a>
                    <a class="nav-link" asp-controller="AdminCategory" asp-action="Index">Categories</a>
                </nav>
            </div>

            <!-- CONTENT -->
            <div class="col-md-10 p-5">
                @RenderBody()
            </div>

        </div>
    </div>

</body>
</html>
